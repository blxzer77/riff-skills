[importlinter]
root_package = shop

[importlinter:contract:protected-internals]
name = Module internals are private
type = protected
protected_modules =
    shop.orders.internal
    shop.billing.internal
allowed_importers =
    shop.orders
    shop.billing

[importlinter:contract:no-cycles]
name = Modules do not import each other in a cycle
type = acyclic_siblings
ancestors =
    shop
